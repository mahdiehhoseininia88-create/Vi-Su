<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI-SUBTITLE</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#101010;color:#fff;font-family:Arial,sans-serif;display:flex;height:100vh}
.sidebar{width:250px;background:#181818;padding:20px;border-left:1px solid #303030}
.logo{font-size:23px;font-weight:bold;color:#ff8c00;margin-bottom:30px}
button{cursor:pointer;border:0;border-radius:10px;padding:12px;background:#ff8c00;color:#111;font-weight:bold}
.newchat{width:100%;margin-bottom:25px}
.sidebar p{color:#999;font-size:13px}
.main{flex:1;display:flex;flex-direction:column;min-width:0}
header{padding:20px;border-bottom:1px solid #303030;font-weight:bold}
.welcome{margin:auto;text-align:center;padding:20px}
.welcome h1{font-size:32px}
.welcome span{color:#ff8c00}
.welcome p{color:#aaa;line-height:2}
.composer{width:min(800px,92%);margin:20px auto 30px;background:#202020;border:1px solid #444;border-radius:18px;padding:12px}
textarea{width:100%;height:65px;background:transparent;color:white;border:0;outline:0;resize:vertical;font-size:16px;padding:10px}
.tools{display:flex;align-items:center;gap:10px}
.attach{background:#333;color:#fff}
.send{margin-right:auto}
#file{display:none}
#messages{width:min(800px,92%);margin:20px auto;overflow:auto;flex:1}
.message{padding:14px;margin:10px 0;border-radius:12px;line-height:1.8;white-space:pre-wrap}
.user{background:#302519}
.bot{background:#202020}
@media(max-width:600px){.sidebar{width:75px;padding:12px}.logo{font-size:12px}.sidebar p{display:none}.welcome h1{font-size:24px}}
</style>
</head>
<body>
<aside class="sidebar">
<div class="logo">AI-SUBTITLE</div>
<button class="newchat" onclick="newChat()">+ گفتگوی جدید</button>
<p>دستیار هوش مصنوعی</p>
<p>💬 گفتگو</p>
<p>🎬 ترجمه ویدئو</p>
<p>📝 زیرنویس خودکار</p>
</aside>
<main class="main">
<header>دستیار هوش مصنوعی <span style="color:#ff8c00">●</span></header>
<section class="welcome" id="welcome">
<h1>سلام! به <span>AI-SUBTITLE</span> خوش آمدی</h1>
<p>سؤالت را بنویس یا فایلی انتخاب کن.<br>برای شروع، یک پیام در کادر پایین بنویس.</p>
</section>
<section id="messages"></section>
<div class="composer">
<textarea id="prompt" placeholder="هر چیزی که می‌خواهی بپرس..."></textarea>
<div class="tools">
<label class="attach button" for="file">📎 پیوست فایل</label>
<input type="file" id="file" accept="image/*,video/*,.pdf,.txt,.doc,.docx,.srt,.vtt">
<button onclick="sendMessage()" class="send">ارسال ↑</button>
</div>
<div id="filename" style="color:#aaa;font-size:12px;margin-top:8px"></div>
</div>
</main>
<script>
const promptBox=document.getElementById('prompt');
const fileBox=document.getElementById('file');
fileBox.addEventListener('change',()=>{
 document.getElementById('filename').textContent=
 fileBox.files.length?'فایل انتخاب‌شده: '+fileBox.files[0].name:'';
});
function addMessage(text,type){
 const el=document.createElement('div');
 el.className='message '+type;
 el.textContent=text;
 document.getElementById('messages').appendChild(el);
 el.scrollIntoView({behavior:'smooth'});
}
function sendMessage(){
 const text=promptBox.value.trim();
 const file=fileBox.files[0];
 if(!text&&!file)return;
 document.getElementById('welcome').style.display='none';
 addMessage((text||'')+(file?'\n📎 فایل انتخاب‌شده: '+file.name:''),'user');
 addMessage('رابط کاربری آماده است؛ برای دریافت پاسخ واقعی هوش مصنوعی باید سرویس هوش مصنوعی را به برنامه متصل کنیم. قابلیت پردازش فایل و ترجمه ویدئو نیز هنوز نیاز به پیاده‌سازی دارد.','bot');
 promptBox.value='';
 fileBox.value='';
 document.getElementById('filename').textContent='';
}
function newChat(){
 document.getElementById('messages').innerHTML='';
 document.getElementById('welcome').style.display='block';
 promptBox.value='';
}
promptBox.addEventListener('keydown',e=>{
 if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendMessage()}
});
</script>
</body>
</html>